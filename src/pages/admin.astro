---
import Admin from '../layouts/Admin.astro';
import { getCategories } from '../lib/posts';
import { configured, isAdmin } from '../lib/auth';
import {
  ArrowUpRight, Bold, ChevronDown, CircleAlert, Code, Ellipsis, Eye, FileText, Globe,
  Heading2, ImagePlus, Italic, Link, Link2, List, LoaderCircle, LogOut,
  MessageCircle, Moon, PenLine, Plus, Save, Search, Send, Settings, Sun, Trash, X,
} from '@lucide/astro';

const categories = await getCategories();
const ready = configured();
const loggedIn = isAdmin(Astro);
const requestedModule = Astro.url.searchParams.get('m');
const currentModule = requestedModule === 'links' ? 'links' : requestedModule === 'site' ? 'site' : 'posts';
const moduleTitle = currentModule === 'links' ? '友链管理' : currentModule === 'site' ? '站点资料' : '写作后台';

/**
 * 模块导航槽位。
 * 新增模块：在这里追加一项，并在 admin.js 的 MODULES 里登记即可，布局不用改。
 * soon: true 表示占位未开放（不可点击），开放时去掉这个标记并接上路由。
 */
const modules = [
  { key: 'posts', label: '文章', href: '/admin', icon: FileText, active: currentModule === 'posts', soon: false },
  { key: 'links', label: '友链', href: '/admin?m=links', icon: Link, active: currentModule === 'links', soon: false },
  { key: 'site', label: '站点', href: '/admin?m=site', icon: Globe, active: currentModule === 'site', soon: false },
  { key: 'moments', label: '朋友圈', href: '/admin?m=moments', icon: MessageCircle, active: false, soon: true },
];
---
<Admin title={moduleTitle}>
  {!ready && (
    <div class="adm-auth">
      <div class="adm-auth-card">
        <span class="adm-auth-eyebrow">配置缺失</span>
        <h1>后台尚未配置</h1>
        <p>请先在服务器环境变量中设置 <code>ADMIN_PASSWORD</code> 与 <code>SESSION_SECRET</code>，保存后重启服务。</p>
        <pre>ADMIN_PASSWORD=你的管理密码
SESSION_SECRET=一串足够长的随机字符</pre>
        <p>完整步骤见 <code>DEPLOY.md</code>。缺少这两项时，后台不会接受任何登录请求。</p>
        <a class="adm-auth-foot" href="/">← 回到前台</a>
      </div>
    </div>
  )}

  {ready && !loggedIn && (
    <div class="adm-auth">
      <div class="adm-auth-card">
        <span class="adm-auth-eyebrow">BAKAMIKU STUDIO</span>
        <h1>写作后台</h1>
        <p>输入管理密码，继续写作。</p>
        <form id="login-form">
          <div class="adm-field" data-field="password">
            <label for="password">管理密码</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
            <p class="adm-field-msg" id="login-status" role="status" aria-live="polite"></p>
          </div>
          <button class="adm-btn adm-btn--primary adm-btn--block" type="submit">登录</button>
        </form>
        <a class="adm-auth-foot" href="/">← 回到前台</a>
      </div>
    </div>
  )}

  {loggedIn && (
    <div class="adm-shell" id="shell" data-module={currentModule} data-view={currentModule === 'links' ? 'links-list' : 'write'} data-settings="closed" data-list="closed">
      <nav class="adm-rail" aria-label="模块导航">
        <a class="adm-rail-brand" href="/" title="回到前台" aria-label="回到前台">M</a>
        <div class="adm-rail-group">
          {modules.map(item => {
            const Icon = item.icon;
            return (
              <a
                class:list={['adm-rail-item', { 'is-active': item.active, 'is-soon': item.soon }]}
                href={item.soon ? undefined : item.href}
                title={item.soon ? `${item.label}（尚未开放）` : item.label}
                aria-current={item.active ? 'page' : undefined}
                aria-disabled={item.soon ? 'true' : undefined}
                tabindex={item.soon ? -1 : undefined}
              >
                <Icon size={18} aria-hidden="true" />
                <span class="adm-rail-label">{item.label}</span>
              </a>
            );
          })}
        </div>
        <div class="adm-rail-spacer"></div>
        <div class="adm-rail-group">
          <button class="adm-rail-item" id="theme-toggle" type="button" title="切换明暗主题" aria-label="切换明暗主题">
            <Moon class="adm-moon" size={18} aria-hidden="true" />
            <Sun class="adm-sun" size={18} aria-hidden="true" />
          </button>
          <button class="adm-rail-item" id="logout" type="button" title="退出登录" aria-label="退出登录">
            <LogOut size={18} aria-hidden="true" />
          </button>
        </div>
      </nav>

      {currentModule === 'posts' && (
      <>
      <header class="adm-topbar">
        <div class="adm-topbar-left">
          <button class="adm-btn adm-btn--icon adm-toggle-list" id="list-toggle" type="button" title="文章列表" aria-label="打开文章列表">
            <List size={18} aria-hidden="true" />
          </button>
          <span class="adm-pill" id="state-pill" data-state="draft">草稿</span>
          <span class="adm-topbar-title" id="topbar-title">新文章</span>
        </div>
        <div class="adm-topbar-right">
          <span class="adm-status" id="save-status" role="status" aria-live="polite" data-state="idle">准备就绪</span>
          <div class="adm-actions">
            <a class="adm-btn adm-btn--ghost" id="public-link" href="#" target="_blank" rel="noopener" hidden>
              查看文章<ArrowUpRight size={14} aria-hidden="true" />
            </a>
            <button class="adm-btn adm-btn--ghost" id="save-post" type="button" title="保存为草稿">存草稿</button>
            <button class="adm-btn adm-btn--primary" id="publish" type="button" title="公开这篇文章">发布</button>
            <button class="adm-btn adm-btn--icon adm-toggle-settings" id="settings-toggle" type="button" title="文章设置" aria-label="打开文章设置" aria-expanded="false">
              <Settings size={18} aria-hidden="true" />
            </button>
            <div class="adm-menu-wrap">
              <button class="adm-btn adm-btn--icon" id="more-btn" type="button" title="更多" aria-haspopup="menu" aria-expanded="false" aria-label="更多操作">
                <Ellipsis size={18} aria-hidden="true" />
              </button>
              <div class="adm-menu" id="more-menu" role="menu" hidden>
                <button type="button" id="new-post" role="menuitem">
                  <Plus size={15} aria-hidden="true" />新建文章
                </button>
                <button type="button" id="delete-post" role="menuitem" class="is-danger">
                  <Trash size={15} aria-hidden="true" />删除文章
                </button>
                <button type="button" id="logout-2" role="menuitem">
                  <LogOut size={15} aria-hidden="true" />退出登录
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <aside class="adm-list" id="list-panel" aria-label="文章列表">
        <div class="adm-list-head">
          <label class="adm-search">
            <Search size={15} aria-hidden="true" />
            <input id="post-search" type="search" placeholder="搜索标题或分类" aria-label="搜索文章" />
          </label>
          <button class="adm-btn adm-btn--icon" id="new-post-2" type="button" title="新建文章" aria-label="新建文章">
            <Plus size={18} aria-hidden="true" />
          </button>
        </div>
        <div class="adm-chips" role="group" aria-label="按状态筛选">
          <button class="adm-chip is-active" type="button" data-filter="all">全部<b id="count-all">0</b></button>
          <button class="adm-chip" type="button" data-filter="draft">草稿<b id="count-draft">0</b></button>
          <button class="adm-chip" type="button" data-filter="published">已发布<b id="count-published">0</b></button>
        </div>
        <div class="adm-list-scroll" id="post-list"></div>
        <div class="adm-list-foot">共 <b id="post-count">0</b> 篇文章</div>
      </aside>

      <section class="adm-main" aria-label="编辑区">
        <div class="adm-scroll" id="editor-scroll">
          <div class="adm-editor">
            <input id="title" class="adm-title" type="text" placeholder="文章标题" maxlength="120" aria-label="文章标题" autocomplete="off" />
            <p class="adm-field-msg" id="title-error" role="alert"></p>
            <textarea id="description" class="adm-summary" rows="2" placeholder="一句话介绍这篇文章（可选）" maxlength="240" aria-label="文章摘要"></textarea>

            <div class="adm-toolbar" role="toolbar" aria-label="Markdown 工具栏">
              <div class="adm-toolbar-group">
                <button class="adm-tool-btn" type="button" data-wrap="**" title="加粗" aria-label="加粗"><Bold size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-wrap="*" title="斜体" aria-label="斜体"><Italic size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-prefix="## " title="二级标题" aria-label="二级标题"><Heading2 size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-prefix="- " title="无序列表" aria-label="无序列表"><List size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-block="code" title="代码块" aria-label="代码块"><Code size={16} aria-hidden="true" /></button>
              </div>
              <span class="adm-toolbar-sep" aria-hidden="true"></span>
              <div class="adm-toolbar-group">
                <button class="adm-tool-btn" type="button" data-block="link" title="链接" aria-label="插入链接"><Link2 size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" id="insert-image" title="上传并插入图片" aria-label="插入图片"><ImagePlus size={16} aria-hidden="true" /></button>
              </div>
            </div>

            <div class="adm-tabs" role="tablist" aria-label="编辑与预览">
              <button class="adm-tab is-active" type="button" role="tab" aria-selected="true" data-view="edit">
                <PenLine size={14} aria-hidden="true" />编辑
              </button>
              <button class="adm-tab" type="button" role="tab" aria-selected="false" data-view="preview">
                <Eye size={14} aria-hidden="true" />预览
              </button>
            </div>

            <textarea id="body" class="adm-body-area" placeholder="在这里写正文，支持 Markdown…" spellcheck="false" aria-label="文章正文"></textarea>
            <p class="adm-field-msg" id="body-error" role="alert"></p>
            <div class="adm-editor-foot" aria-live="off">
              <span id="word-count">0 字</span>
              <span class="adm-editor-foot-sep" aria-hidden="true">·</span>
              <span id="read-time">约 0 分钟阅读</span>
            </div>
            <div id="preview" class="adm-preview" hidden></div>
          </div>
        </div>
      </section>

      <aside class="adm-settings" id="settings-panel" aria-label="文章设置">
        <div class="adm-settings-head">
          <h2>文章设置</h2>
          <button class="adm-btn adm-btn--icon adm-settings-close" id="settings-close" type="button" title="关闭设置" aria-label="关闭设置">
            <X size={16} aria-hidden="true" />
          </button>
        </div>
        <div class="adm-settings-body">
          <section class="adm-group">
            <h3>分类</h3>
            <div class="adm-field" data-field="category">
              <label for="category">大类</label>
              <select id="category">
                {categories.map(name => <option value={name}>{name}</option>)}
              </select>
              <p class="adm-field-msg" id="category-error" role="alert"></p>
            </div>
            <div class="adm-field" data-field="new-category">
              <label for="new-category">新建大类</label>
              <div class="adm-inline">
                <input id="new-category" type="text" placeholder="例如：读书笔记" maxlength="24" autocomplete="off" />
                <button class="adm-btn adm-btn--sm" id="create-category" type="button">添加</button>
              </div>
              <p class="adm-field-msg" id="category-status" role="status" aria-live="polite"></p>
            </div>
            <div class="adm-field">
              <label for="tags">小类</label>
              <input id="tags" type="text" placeholder="随笔, 前端" autocomplete="off" aria-describedby="tags-hint" />
              <p class="adm-hint" id="tags-hint">用逗号分隔，中英文逗号都行，可留空。</p>
            </div>
          </section>

          <section class="adm-group">
            <h3>展示</h3>
            <div class="adm-field" data-field="date">
              <label for="date">显示日期</label>
              <input id="date" type="date" />
              <p class="adm-hint">只影响列表与文章页显示的日期。</p>
              <p class="adm-field-msg" id="date-error" role="alert"></p>
            </div>
            <div class="adm-field" data-field="cover">
              <label for="cover">封面路径</label>
              <input id="cover" type="text" placeholder="/uploads/cover.jpg" autocomplete="off" aria-describedby="cover-hint" />
              <p class="adm-hint" id="cover-hint">需以 <code>/uploads/</code> 或 <code>/images/</code> 开头，否则不会保存。</p>
              <p class="adm-field-msg" id="cover-error" role="alert"></p>
            </div>
            <div class="adm-field">
              <label for="badge">文章角标</label>
              <input id="badge" type="text" placeholder="显示在封面左上角" maxlength="24" autocomplete="off" />
            </div>
          </section>

          <section class="adm-group">
            <h3>操作</h3>
            <p class="adm-hint" id="save-help">存草稿不会公开；点发布后文章才会出现在前台。</p>
            <div class="adm-public-row" id="public-row" hidden>
              <a id="public-link-2" href="#" target="_blank" rel="noopener">查看已发布文章 ↗</a>
            </div>
            <button class="adm-btn adm-btn--danger" id="delete-post-2" type="button">
              <Trash size={15} aria-hidden="true" />删除文章
            </button>
            <p class="adm-hint" style="margin-top:8px">删除不可撤销。</p>
          </section>
        </div>
      </aside>
      </>
      )}

      {currentModule === 'links' && (
      <>
        <header class="adm-topbar adm-links-topbar">
          <div class="adm-topbar-left">
            <span class="adm-pill" data-state="published">友链</span>
            <div class="adm-topbar-title-group">
              <strong>友链管理</strong>
              <span id="links-count">0 条友链</span>
            </div>
          </div>
          <div class="adm-topbar-right">
            <span class="adm-status" id="links-status" role="status" aria-live="polite" data-state="idle">准备就绪</span>
            <div class="adm-actions">
              <a class="adm-btn adm-btn--ghost" href="/links" target="_blank" rel="noopener">查看前台</a>
              <button class="adm-btn adm-btn--ghost" id="link-import" type="button" title="从 JSON 文件导入友链（按地址合并）">导入</button>
              <button class="adm-btn adm-btn--ghost" id="link-export" type="button" title="导出全部友链为 JSON">导出</button>
              <button class="adm-btn adm-btn--primary" id="link-new" type="button">新建友链</button>
            </div>
          </div>
        </header>

        <section class="adm-links-main" aria-label="友链管理">
          <div class="adm-links-content">
            <div class="adm-links-panel">
              <div class="adm-links-summary" aria-label="友链统计">
                <section class="adm-link-stat" data-filter="all" role="button" tabindex="0" aria-label="全部友链">
                  <b id="link-count-all">0</b>
                  <span>全部友链</span>
                </section>
                <section class="adm-link-stat is-live" data-filter="live" role="button" tabindex="0" aria-label="展示中">
                  <b id="link-count-live">0</b>
                  <span>展示中</span>
                </section>
                <section class="adm-link-stat is-muted" data-filter="hidden" role="button" tabindex="0" aria-label="已隐藏">
                  <b id="link-count-hidden">0</b>
                  <span>已隐藏</span>
                </section>
                <section class="adm-link-stat is-error" data-filter="error" role="button" tabindex="0" aria-label="异常链接">
                  <b id="link-count-error">0</b>
                  <span>异常链接</span>
                </section>
              </div>

              <div class="adm-links-toolbar">
                <label class="adm-search adm-links-search">
                  <Search size={15} aria-hidden="true" />
                  <input id="link-search" type="search" placeholder="搜索站点名称、URL 或分组" aria-label="搜索友链" />
                  <button id="link-search-clear" class="adm-search-clear" type="button" aria-label="清空搜索">×</button>
                </label>
                <select id="link-status-filter" aria-label="按展示状态筛选">
                  <option value="all">全部状态</option>
                  <option value="live">展示中</option>
                  <option value="hidden">已隐藏</option>
                  <option value="error">访问异常</option>
                </select>
                <select id="link-group-filter" aria-label="按分组筛选">
                  <option value="all">全部分组</option>
                </select>
                <button class="adm-btn adm-btn--ghost" id="link-check-error" type="button" title="仅重新检测访问异常的链接">检测异常</button>
                <button class="adm-btn adm-btn--ghost" id="link-check-all" type="button" title="检测选中项，未选择时检测当前筛选结果">检测链接</button>
                <button class="adm-btn adm-btn--ghost" id="link-check-every" type="button" title="忽略筛选，检测全部友链">全量检测</button>
              </div>

              <div class="adm-links-bulk" id="link-bulkbar" hidden>
                <span id="link-selected-count">已选择 0 项</span>
                <div class="adm-links-bulk-actions">
                  <input id="link-bulk-group" type="text" placeholder="新分组" maxlength="24" aria-label="批量调整分组" />
                  <button class="adm-btn adm-btn--sm adm-btn--ghost" type="button" data-bulk="group">调整分组</button>
                  <button class="adm-btn adm-btn--sm adm-btn--ghost" type="button" data-bulk="show">展示</button>
                  <button class="adm-btn adm-btn--sm adm-btn--ghost" type="button" data-bulk="hide">隐藏</button>
                  <button class="adm-btn adm-btn--sm adm-btn--danger-link" type="button" data-bulk="delete">删除</button>
                </div>
              </div>

              <div class="adm-link-table" role="table" aria-label="友链列表">
                <div class="adm-link-row adm-link-row--head" role="row">
                  <span class="adm-link-cell adm-link-cell--select" role="columnheader">
                    <input id="link-select-all" type="checkbox" aria-label="选择全部友链" />
                  </span>
                  <span class="adm-link-cell adm-link-cell--site" role="columnheader">站点</span>
                  <span class="adm-link-cell adm-link-cell--group" role="columnheader">分组</span>
                  <span class="adm-link-cell adm-link-cell--status" role="columnheader">展示与检测</span>
                  <span class="adm-link-cell adm-link-cell--order" role="columnheader">排序</span>
                  <span class="adm-link-cell adm-link-cell--actions" role="columnheader">操作</span>
                </div>
                <div id="link-list" class="adm-link-list" role="rowgroup"></div>
                <div class="adm-link-table-foot">
                  <span id="link-table-count">共 0 条</span>
                  <span>清空筛选后可拖拽排序</span>
                </div>
              </div>
            </div>

            <aside class="adm-links-inspector" id="link-inspector" data-open="true" aria-label="编辑友链">
              <div class="adm-links-inspector-head">
                <div>
                  <h2 id="link-editor-title">新建友链</h2>
                  <p id="link-editor-subtitle">填写站点信息，保存后立即同步</p>
                </div>
                <button class="adm-btn adm-btn--icon" id="link-inspector-close" type="button" aria-label="关闭编辑面板">
                  <X size={16} aria-hidden="true" />
                </button>
              </div>

              <div class="adm-links-inspector-body">
                <input id="link-id" type="hidden" />
                <div class="adm-field">
                  <label for="link-name">站点名称</label>
                  <input id="link-name" type="text" maxlength="40" placeholder="例如：林中小站" autocomplete="off" />
                  <p class="adm-field-msg" id="link-name-error" role="alert"></p>
                </div>
                <div class="adm-field">
                  <label for="link-url">链接地址</label>
                  <input id="link-url" type="url" placeholder="https://example.com" autocomplete="off" />
                  <p class="adm-field-msg" id="link-url-error" role="alert"></p>
                </div>
                <div class="adm-field">
                  <label for="link-avatar">头像地址</label>
                  <div class="adm-inline">
                    <input id="link-avatar" type="text" placeholder="/uploads/avatar.webp 或 https://..." autocomplete="off" />
                    <button class="adm-btn adm-btn--sm" id="link-avatar-upload" type="button">上传</button>
                  </div>
                  <div class="adm-avatar-preview" id="link-avatar-preview" hidden aria-hidden="true"></div>
                  <p class="adm-hint">支持本站 /uploads/、/images/ 或 HTTPS 图片，最大 2MB。</p>
                  <p class="adm-field-msg" id="link-avatar-error" role="alert"></p>
                </div>
                <div class="adm-field">
                  <label for="link-preview">站点首图</label>
                  <div class="adm-inline">
                    <input id="link-preview" type="text" placeholder="/uploads/preview.webp 或 https://..." autocomplete="off" />
                    <button class="adm-btn adm-btn--sm" id="link-preview-upload" type="button">上传</button>
                  </div>
                  <div class="adm-avatar-preview adm-shot-preview" id="link-preview-preview" hidden aria-hidden="true"></div>
                  <p class="adm-hint">鼠标悬停卡片时弹出的预览图，建议 16:10、宽 640px 以上；留空则不弹。</p>
                  <p class="adm-field-msg" id="link-preview-error" role="alert"></p>
                </div>
                <div class="adm-field">
                  <label for="link-group">分组</label>
                  <input id="link-group" type="text" maxlength="24" placeholder="朋友" autocomplete="off" />
                </div>
                <div class="adm-field">
                  <label for="link-tags">标签</label>
                  <input id="link-tags" type="text" maxlength="80" placeholder="技术, 设计, 生活" autocomplete="off" aria-describedby="link-tags-hint" />
                  <p class="adm-hint" id="link-tags-hint">用逗号分隔，最多 6 个；会显示在前台卡片上，也参与搜索。</p>
                </div>
                <div class="adm-field">
                  <label for="link-description">站点描述</label>
                  <textarea id="link-description" rows="4" maxlength="160" placeholder="一句话介绍这个站点（可选）"></textarea>
                </div>
                <div class="adm-field">
                  <label for="link-order">排序权重（数字越小越靠前）</label>
                  <input id="link-order" type="number" min="-9999" max="9999" step="1" />
                </div>

                <label class="adm-switch-row">
                  <span>在前台展示</span>
                  <input id="link-active" type="checkbox" checked />
                  <i aria-hidden="true"></i>
                </label>
                <label class="adm-switch-row">
                  <span>允许搜索引擎跟随</span>
                  <input id="link-nofollow" type="checkbox" checked />
                  <i aria-hidden="true"></i>
                </label>

                <div class="adm-link-health">
                  <div>
                    <strong>链接检测</strong>
                    <p id="link-health-text">尚未检测</p>
                  </div>
                  <button class="adm-btn adm-btn--sm" id="link-check-one" type="button">重新检测</button>
                </div>
              </div>

              <div class="adm-links-inspector-foot">
                <button class="adm-btn adm-btn--danger" id="link-delete" type="button" disabled>删除友链</button>
                <div class="adm-links-inspector-actions">
                  <button class="adm-btn adm-btn--ghost" id="link-cancel" type="button">取消</button>
                  <button class="adm-btn adm-btn--primary" id="link-save" type="button">保存修改</button>
                </div>
              </div>
              <input id="link-avatar-file" type="file" accept="image/*" hidden />
              <input id="link-preview-file" type="file" accept="image/*" hidden />
              <input id="link-import-file" type="file" accept="application/json,.json" hidden />
            </aside>
          </div>
        </section>

        <nav class="adm-tabbar adm-links-tabbar" aria-label="友链视图切换">
          <button class="is-active" type="button" data-links-view="list"><List size={18} aria-hidden="true" />列表</button>
          <button type="button" data-links-view="edit"><Settings size={18} aria-hidden="true" />编辑</button>
        </nav>
      </>
      )}

      {currentModule === 'site' && (
      <>
        <header class="adm-topbar adm-links-topbar">
          <div class="adm-topbar-left">
            <span class="adm-pill" data-state="published">站点</span>
            <div class="adm-topbar-title-group">
              <strong>站点资料</strong>
              <span>换友链时给对方抄的那一份</span>
            </div>
          </div>
          <div class="adm-topbar-right">
            <span class="adm-status" id="site-status" role="status" aria-live="polite" data-state="idle">准备就绪</span>
            <div class="adm-actions">
              <a class="adm-btn adm-btn--ghost" href="/links" target="_blank" rel="noopener">查看友链页</a>
              <button class="adm-btn adm-btn--primary" id="site-save" type="button">保存资料</button>
            </div>
          </div>
        </header>

        <section class="adm-site-main" aria-label="站点资料">
          <div class="adm-site-card">
            <div class="adm-site-preview" id="site-preview-box" hidden>
              <img alt="首页图片预览" />
              <span>首页图片预览</span>
            </div>

            <div class="adm-site-grid">
              <div class="adm-field">
                <label for="site-name">站点名称</label>
                <input id="site-name" type="text" maxlength="40" autocomplete="off" />
                <p class="adm-field-msg" id="site-name-error" role="alert"></p>
              </div>
              <div class="adm-field">
                <label for="site-url">站点地址</label>
                <input id="site-url" type="url" placeholder="https://example.com" autocomplete="off" />
                <p class="adm-field-msg" id="site-url-error" role="alert"></p>
              </div>
              <div class="adm-field">
                <label for="site-avatar">头像</label>
                <div class="adm-inline">
                  <input id="site-avatar" type="text" placeholder="/uploads/avatar.webp 或 https://..." autocomplete="off" />
                  <button class="adm-btn adm-btn--sm" id="site-avatar-upload" type="button">上传</button>
                </div>
                <p class="adm-field-msg" id="site-avatar-error" role="alert"></p>
              </div>
              <div class="adm-field">
                <label for="site-preview">首页图片</label>
                <div class="adm-inline">
                  <input id="site-preview" type="text" placeholder="/uploads/home.webp 或 https://..." autocomplete="off" />
                  <button class="adm-btn adm-btn--sm" id="site-preview-upload" type="button">上传</button>
                </div>
                <p class="adm-hint">建议 16:10、宽 640px 以上，会一起出现在友链页的「本站信息」里。</p>
                <p class="adm-field-msg" id="site-preview-error" role="alert"></p>
              </div>
            </div>

            <div class="adm-field">
              <label for="site-description">描述</label>
              <textarea id="site-description" rows="3" maxlength="160" placeholder="一句话介绍这个站点"></textarea>
              <p class="adm-hint">最多 160 字，会作为「简介」出现在信息卡里。</p>
            </div>

            <div class="adm-field">
              <label for="site-tags">标签</label>
              <input id="site-tags" type="text" maxlength="80" placeholder="技术, 二次元, 个人博客" autocomplete="off" />
              <p class="adm-hint">逗号分隔，最多 6 个；会作为「标签」出现在信息卡里。</p>
            </div>

            <input id="site-avatar-file" type="file" accept="image/*" hidden />
            <input id="site-preview-file" type="file" accept="image/*" hidden />
          </div>
        </section>
      </>
      )}

      {currentModule === 'posts' && (
      <nav class="adm-tabbar" aria-label="视图切换">
        <button type="button" data-view="list"><List size={18} aria-hidden="true" />列表</button>
        <button class="is-active" type="button" data-view="write"><PenLine size={18} aria-hidden="true" />写作</button>
        <button type="button" data-view="settings"><Settings size={18} aria-hidden="true" />设置</button>
      </nav>
      )}

      <div class="adm-banner" id="backup-banner" hidden>
        <span>发现本机自动暂存的内容</span>
        <button class="is-primary" type="button" id="backup-restore">恢复</button>
        <button type="button" id="backup-discard">丢弃</button>
      </div>

      <button class="adm-scrim" id="scrim" type="button" tabindex="-1" aria-hidden="true" aria-label="关闭面板"></button>

      <input id="image-file" type="file" accept="image/*" hidden />
    </div>
  )}

  <dialog class="adm-dialog" id="confirm-dialog">
    <div class="adm-dialog-body">
      <h2 id="confirm-title">确认</h2>
      <p id="confirm-text"></p>
    </div>
    <div class="adm-dialog-actions">
      <button class="adm-btn adm-btn--ghost" type="button" id="confirm-cancel">取消</button>
      <button class="adm-btn adm-btn--primary" type="button" id="confirm-ok">确定</button>
    </div>
  </dialog>

  {ready && !loggedIn && <script is:inline>
    document.querySelector('#login-form')?.addEventListener('submit', async event => {
      event.preventDefault();
      const form = event.currentTarget;
      const status = document.querySelector('#login-status');
      const field = form.querySelector('[data-field="password"]');
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      status.textContent = '验证中…';
      status.dataset.state = '';
      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: form.elements.password.value })
        });
        const data = await res.json();
        if (res.ok) { location.reload(); return; }
        throw new Error(data.error || '登录失败');
      } catch (error) {
        status.textContent = error.message;
        status.dataset.state = 'error';
        field.classList.add('is-invalid');
      } finally {
        button.disabled = false;
      }
    });
  </script>}
  {loggedIn && currentModule === 'posts' && <script is:inline src="/admin.js"></script>}
  {loggedIn && currentModule === 'links' && <script is:inline src="/admin-links.js"></script>}
  {loggedIn && currentModule === 'site' && <script is:inline src="/admin-site.js"></script>}
</Admin>
