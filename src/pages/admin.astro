---
import Admin from '../layouts/Admin.astro';
import { getCategories } from '../lib/posts';
import { configured, isAdmin } from '../lib/auth';
import {
  ArrowUpRight, Bold, ChevronDown, CircleAlert, Code, Ellipsis, Eye, FileText,
  Heading2, ImagePlus, Italic, Link, Link2, List, LoaderCircle, LogOut,
  MessageCircle, Moon, PenLine, Plus, Save, Search, Send, Settings, Sun, Trash, X,
} from '@lucide/astro';

const categories = await getCategories();
const ready = configured();
const loggedIn = isAdmin(Astro);

/**
 * 模块导航槽位。
 * 新增模块：在这里追加一项，并在 admin.js 的 MODULES 里登记即可，布局不用改。
 * soon: true 表示占位未开放（不可点击），开放时去掉这个标记并接上路由。
 */
const modules = [
  { key: 'posts', label: '文章', href: '/admin', icon: FileText, active: true, soon: false },
  { key: 'links', label: '友链', href: '/admin?m=links', icon: Link, active: false, soon: true },
  { key: 'moments', label: '朋友圈', href: '/admin?m=moments', icon: MessageCircle, active: false, soon: true },
];
---
<Admin title="写作后台">
  {!ready && (
    <div class="adm-auth">
      <div class="adm-auth-card">
        <span class="adm-auth-eyebrow">配置缺失</span>
        <h1>后台尚未配置</h1>
        <p>请先在服务器环境变量中设置 <code>ADMIN_PASSWORD</code> 与 <code>SESSION_SECRET</code>，保存后重启服务。</p>
        <pre>ADMIN_PASSWORD=你的管理密码
SESSION_SECRET=一串足够长的随机字符</pre>
        <p>完整步骤见 <code>DEPLOY.md</code>。缺少这两项时，后台不会接受任何登录请求。</p>
        <a class="adm-auth-foot" href="/">← 回到前台</a>
      </div>
    </div>
  )}

  {ready && !loggedIn && (
    <div class="adm-auth">
      <div class="adm-auth-card">
        <span class="adm-auth-eyebrow">BAKAMIKU STUDIO</span>
        <h1>写作后台</h1>
        <p>输入管理密码，继续写作。</p>
        <form id="login-form">
          <div class="adm-field" data-field="password">
            <label for="password">管理密码</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
            <p class="adm-field-msg" id="login-status" role="status" aria-live="polite"></p>
          </div>
          <button class="adm-btn adm-btn--primary adm-btn--block" type="submit">登录</button>
        </form>
        <a class="adm-auth-foot" href="/">← 回到前台</a>
      </div>
    </div>
  )}

  {loggedIn && (
    <div class="adm-shell" id="shell" data-view="write" data-settings="closed" data-list="closed">
      <nav class="adm-rail" aria-label="模块导航">
        <a class="adm-rail-brand" href="/" title="回到前台" aria-label="回到前台">M</a>
        <div class="adm-rail-group">
          {modules.map(item => {
            const Icon = item.icon;
            return (
              <a
                class:list={['adm-rail-item', { 'is-active': item.active, 'is-soon': item.soon }]}
                href={item.soon ? undefined : item.href}
                title={item.soon ? `${item.label}（尚未开放）` : item.label}
                aria-current={item.active ? 'page' : undefined}
                aria-disabled={item.soon ? 'true' : undefined}
                tabindex={item.soon ? -1 : undefined}
              >
                <Icon size={18} aria-hidden="true" />
                <span class="adm-rail-label">{item.label}</span>
              </a>
            );
          })}
        </div>
        <div class="adm-rail-spacer"></div>
        <div class="adm-rail-group">
          <button class="adm-rail-item" id="theme-toggle" type="button" title="切换明暗主题" aria-label="切换明暗主题">
            <Moon class="adm-moon" size={18} aria-hidden="true" />
            <Sun class="adm-sun" size={18} aria-hidden="true" />
          </button>
          <button class="adm-rail-item" id="logout" type="button" title="退出登录" aria-label="退出登录">
            <LogOut size={18} aria-hidden="true" />
          </button>
        </div>
      </nav>

      <header class="adm-topbar">
        <div class="adm-topbar-left">
          <button class="adm-btn adm-btn--icon adm-toggle-list" id="list-toggle" type="button" title="文章列表" aria-label="打开文章列表">
            <List size={18} aria-hidden="true" />
          </button>
          <span class="adm-pill" id="state-pill" data-state="draft">草稿</span>
          <span class="adm-topbar-title" id="topbar-title">新文章</span>
        </div>
        <div class="adm-topbar-right">
          <span class="adm-status" id="save-status" role="status" aria-live="polite" data-state="idle">准备就绪</span>
          <div class="adm-actions">
            <a class="adm-btn adm-btn--ghost" id="public-link" href="#" target="_blank" rel="noopener" hidden>
              查看文章<ArrowUpRight size={14} aria-hidden="true" />
            </a>
            <button class="adm-btn adm-btn--ghost" id="save-post" type="button" title="保存为草稿">存草稿</button>
            <button class="adm-btn adm-btn--primary" id="publish" type="button" title="公开这篇文章">发布</button>
            <button class="adm-btn adm-btn--icon adm-toggle-settings" id="settings-toggle" type="button" title="文章设置" aria-label="打开文章设置" aria-expanded="false">
              <Settings size={18} aria-hidden="true" />
            </button>
            <div class="adm-menu-wrap">
              <button class="adm-btn adm-btn--icon" id="more-btn" type="button" title="更多" aria-haspopup="menu" aria-expanded="false" aria-label="更多操作">
                <Ellipsis size={18} aria-hidden="true" />
              </button>
              <div class="adm-menu" id="more-menu" role="menu" hidden>
                <button type="button" id="new-post" role="menuitem">
                  <Plus size={15} aria-hidden="true" />新建文章
                </button>
                <button type="button" id="delete-post" role="menuitem" class="is-danger">
                  <Trash size={15} aria-hidden="true" />删除文章
                </button>
                <button type="button" id="logout-2" role="menuitem">
                  <LogOut size={15} aria-hidden="true" />退出登录
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <aside class="adm-list" id="list-panel" aria-label="文章列表">
        <div class="adm-list-head">
          <label class="adm-search">
            <Search size={15} aria-hidden="true" />
            <input id="post-search" type="search" placeholder="搜索标题或分类" aria-label="搜索文章" />
          </label>
          <button class="adm-btn adm-btn--icon" id="new-post-2" type="button" title="新建文章" aria-label="新建文章">
            <Plus size={18} aria-hidden="true" />
          </button>
        </div>
        <div class="adm-chips" role="group" aria-label="按状态筛选">
          <button class="adm-chip is-active" type="button" data-filter="all">全部<b id="count-all">0</b></button>
          <button class="adm-chip" type="button" data-filter="draft">草稿<b id="count-draft">0</b></button>
          <button class="adm-chip" type="button" data-filter="published">已发布<b id="count-published">0</b></button>
        </div>
        <div class="adm-list-scroll" id="post-list"></div>
        <div class="adm-list-foot">共 <b id="post-count">0</b> 篇文章</div>
      </aside>

      <section class="adm-main" aria-label="编辑区">
        <div class="adm-scroll" id="editor-scroll">
          <div class="adm-editor">
            <input id="title" class="adm-title" type="text" placeholder="文章标题" maxlength="120" aria-label="文章标题" autocomplete="off" />
            <p class="adm-field-msg" id="title-error" role="alert"></p>
            <textarea id="description" class="adm-summary" rows="2" placeholder="一句话介绍这篇文章（可选）" maxlength="240" aria-label="文章摘要"></textarea>

            <div class="adm-toolbar" role="toolbar" aria-label="Markdown 工具栏">
              <div class="adm-toolbar-group">
                <button class="adm-tool-btn" type="button" data-wrap="**" title="加粗" aria-label="加粗"><Bold size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-wrap="*" title="斜体" aria-label="斜体"><Italic size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-prefix="## " title="二级标题" aria-label="二级标题"><Heading2 size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-prefix="- " title="无序列表" aria-label="无序列表"><List size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" data-block="code" title="代码块" aria-label="代码块"><Code size={16} aria-hidden="true" /></button>
              </div>
              <span class="adm-toolbar-sep" aria-hidden="true"></span>
              <div class="adm-toolbar-group">
                <button class="adm-tool-btn" type="button" data-block="link" title="链接" aria-label="插入链接"><Link2 size={16} aria-hidden="true" /></button>
                <button class="adm-tool-btn" type="button" id="insert-image" title="上传并插入图片" aria-label="插入图片"><ImagePlus size={16} aria-hidden="true" /></button>
              </div>
            </div>

            <div class="adm-tabs" role="tablist" aria-label="编辑与预览">
              <button class="adm-tab is-active" type="button" role="tab" aria-selected="true" data-view="edit">
                <PenLine size={14} aria-hidden="true" />编辑
              </button>
              <button class="adm-tab" type="button" role="tab" aria-selected="false" data-view="preview">
                <Eye size={14} aria-hidden="true" />预览
              </button>
            </div>

            <textarea id="body" class="adm-body-area" placeholder="在这里写正文，支持 Markdown…" spellcheck="false" aria-label="文章正文"></textarea>
            <p class="adm-field-msg" id="body-error" role="alert"></p>
            <div id="preview" class="adm-preview" hidden></div>
          </div>
        </div>
      </section>

      <aside class="adm-settings" id="settings-panel" aria-label="文章设置">
        <div class="adm-settings-head">
          <h2>文章设置</h2>
          <button class="adm-btn adm-btn--icon adm-settings-close" id="settings-close" type="button" title="关闭设置" aria-label="关闭设置">
            <X size={16} aria-hidden="true" />
          </button>
        </div>
        <div class="adm-settings-body">
          <section class="adm-group">
            <h3>分类</h3>
            <div class="adm-field" data-field="category">
              <label for="category">大类</label>
              <select id="category">
                {categories.map(name => <option value={name}>{name}</option>)}
              </select>
              <p class="adm-field-msg" id="category-error" role="alert"></p>
            </div>
            <div class="adm-field" data-field="new-category">
              <label for="new-category">新建大类</label>
              <div class="adm-inline">
                <input id="new-category" type="text" placeholder="例如：读书笔记" maxlength="24" autocomplete="off" />
                <button class="adm-btn adm-btn--sm" id="create-category" type="button">添加</button>
              </div>
              <p class="adm-field-msg" id="category-status" role="status" aria-live="polite"></p>
            </div>
            <div class="adm-field">
              <label for="tags">小类</label>
              <input id="tags" type="text" placeholder="随笔, 前端" autocomplete="off" aria-describedby="tags-hint" />
              <p class="adm-hint" id="tags-hint">用逗号分隔，中英文逗号都行，可留空。</p>
            </div>
          </section>

          <section class="adm-group">
            <h3>展示</h3>
            <div class="adm-field" data-field="date">
              <label for="date">显示日期</label>
              <input id="date" type="date" />
              <p class="adm-hint">只影响列表与文章页显示的日期。</p>
              <p class="adm-field-msg" id="date-error" role="alert"></p>
            </div>
            <div class="adm-field" data-field="cover">
              <label for="cover">封面路径</label>
              <input id="cover" type="text" placeholder="/uploads/cover.jpg" autocomplete="off" aria-describedby="cover-hint" />
              <p class="adm-hint" id="cover-hint">需以 <code>/uploads/</code> 或 <code>/images/</code> 开头，否则不会保存。</p>
              <p class="adm-field-msg" id="cover-error" role="alert"></p>
            </div>
            <div class="adm-field">
              <label for="badge">文章角标</label>
              <input id="badge" type="text" placeholder="显示在封面左上角" maxlength="24" autocomplete="off" />
            </div>
          </section>

          <section class="adm-group">
            <h3>操作</h3>
            <p class="adm-hint" id="save-help">存草稿不会公开；点发布后文章才会出现在前台。</p>
            <div class="adm-link-row" id="public-row" hidden>
              <a id="public-link-2" href="#" target="_blank" rel="noopener">查看已发布文章 ↗</a>
            </div>
            <button class="adm-btn adm-btn--danger" id="delete-post-2" type="button">
              <Trash size={15} aria-hidden="true" />删除文章
            </button>
            <p class="adm-hint" style="margin-top:8px">删除不可撤销。</p>
          </section>
        </div>
      </aside>

      <nav class="adm-tabbar" aria-label="视图切换">
        <button type="button" data-view="list"><List size={18} aria-hidden="true" />列表</button>
        <button class="is-active" type="button" data-view="write"><PenLine size={18} aria-hidden="true" />写作</button>
        <button type="button" data-view="settings"><Settings size={18} aria-hidden="true" />设置</button>
      </nav>

      <div class="adm-banner" id="backup-banner" hidden>
        <span>发现本机自动暂存的内容</span>
        <button class="is-primary" type="button" id="backup-restore">恢复</button>
        <button type="button" id="backup-discard">丢弃</button>
      </div>

      <button class="adm-scrim" id="scrim" type="button" tabindex="-1" aria-hidden="true" aria-label="关闭面板"></button>

      <input id="image-file" type="file" accept="image/*" hidden />
    </div>
  )}

  <dialog class="adm-dialog" id="confirm-dialog">
    <div class="adm-dialog-body">
      <h2 id="confirm-title">确认</h2>
      <p id="confirm-text"></p>
    </div>
    <div class="adm-dialog-actions">
      <button class="adm-btn adm-btn--ghost" type="button" id="confirm-cancel">取消</button>
      <button class="adm-btn adm-btn--primary" type="button" id="confirm-ok">确定</button>
    </div>
  </dialog>

  {ready && !loggedIn && <script is:inline>
    document.querySelector('#login-form')?.addEventListener('submit', async event => {
      event.preventDefault();
      const form = event.currentTarget;
      const status = document.querySelector('#login-status');
      const field = form.querySelector('[data-field="password"]');
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      status.textContent = '验证中…';
      status.dataset.state = '';
      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: form.elements.password.value })
        });
        const data = await res.json();
        if (res.ok) { location.reload(); return; }
        throw new Error(data.error || '登录失败');
      } catch (error) {
        status.textContent = error.message;
        status.dataset.state = 'error';
        field.classList.add('is-invalid');
      } finally {
        button.disabled = false;
      }
    });
  </script>}
  {loggedIn && <script is:inline src="/admin.js"></script>}
</Admin>
