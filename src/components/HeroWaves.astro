---
// 首页 Hero 与文章区之间的水波过渡。
// 四层同形波浪全部半透明（25/50/65/75），叠加处透明度累积成实底，
// 未叠加处透出插画 —— 与 l3thargy.cn / rainzt.cn 的 header-waves 一致。
// x 偏移让首帧四层相位均匀错开（0/0.25/0.5/0.75），脚本再按次随机相位。
---
<div class="hero-waves" aria-hidden="true">
  <svg class="hero-waves__svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="geometricPrecision" focusable="false">
    <defs>
      <path id="hero-gentle-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z" />
    </defs>
    <g class="hero-waves__parallax">
      <use href="#hero-gentle-wave" x="-42" y="0" />
      <use href="#hero-gentle-wave" x="2.641" y="3" />
      <use href="#hero-gentle-wave" x="48.944" y="5" />
      <use href="#hero-gentle-wave" x="92.468" y="7" />
    </g>
  </svg>
</div>

<script>
  // 每次加载给四层各自一个随机相位与轻微随机的周期，波浪不会整齐叠在一起
  const layers = Array.from(document.querySelectorAll<SVGUseElement>('.hero-waves__parallax > use'));
  if (layers.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const baseDurations = [34, 46, 58, 72];
    layers.forEach((layer, index) => {
      const duration = baseDurations[index % baseDurations.length] * (0.85 + Math.random() * 0.3);
      layer.style.animationDuration = `${duration.toFixed(2)}s`;
      layer.style.animationDelay = `${(-Math.random() * duration).toFixed(2)}s`;
    });
  }
</script>
