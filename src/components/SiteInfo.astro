---
import { Blocks, CalendarClock, ChevronDown, Cloud, CodeXml, Globe, Monitor, Package, ServerCog } from '@lucide/astro';
import { astroVersion, nodeVersion, npmVersion, system } from '../lib/runtimeInfo';

const domain = (Astro.request.headers.get('host') || Astro.url.host).split(':')[0];
const buildTime = new Date(__BLOG_BUILD_TIME__).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });
---
<section class="side-section site-info" aria-labelledby="site-info-title">
  <h2 id="site-info-title">站点信息</h2>
  <div class="info-row"><Cloud size={16} aria-hidden="true" /><span>构建平台</span><strong>Astro + Node.js</strong></div>
  <div class="info-row"><Blocks size={16} aria-hidden="true" /><span>博客版本</span><strong>BM V1.0.0</strong></div>
  <details class="site-details">
    <summary><ChevronDown size={16} aria-hidden="true" />展开构建信息</summary>
    <div class="site-details__body">
    <div class="detail-domain"><Globe size={18} aria-hidden="true" /><span>站点域名</span><strong>{domain}</strong></div>
    <div class="version-grid">
      <div><CodeXml size={18} aria-hidden="true" /><span>Astro</span><strong>v{astroVersion}</strong></div>
      <div><ServerCog size={18} aria-hidden="true" /><span>Node.js</span><strong>{nodeVersion}</strong></div>
      <div><Package size={18} aria-hidden="true" /><span>npm</span><strong>v{npmVersion}</strong></div>
      <div><Blocks size={18} aria-hidden="true" /><span>博客</span><strong>BM V1.0.0</strong></div>
    </div>
    <div class="detail-line"><CalendarClock size={17} aria-hidden="true" /><div><span>构建时间（北京时间）</span><strong>{buildTime}</strong></div></div>
    <div class="detail-line"><Monitor size={17} aria-hidden="true" /><div><span>系统信息</span><strong>{system}</strong></div></div>
    </div>
  </details>
</section>

<script>
  // 构建信息在 ≥1280 是向左弹出的浮层：点空白处 / 按 Esc 收起，别让它一直挂在那儿
  const details = document.querySelector<HTMLDetailsElement>('.site-details');
  if (details) {
    document.addEventListener('pointerdown', event => {
      if (details.open && !details.contains(event.target as Node)) details.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });
  }
</script>
