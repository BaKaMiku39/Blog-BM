# =============================================================================
# BaKaMiku 博客 · 环境变量示例
#
#   cp .env.example .env      复制一份再填
#   npm run config:check      打印当前生效配置（密码自动打码）+ 检查缺项
#
# 这里只放「随环境变化」的东西：密钥、地址、开关。
# 站点名、导航、slogan 这类写死的身份信息在 src/config/site.ts。
# 详细说明见 CONFIG.md。
# =============================================================================

# ── 运行 ─────────────────────────────────────────────────────────────────────
# 监听地址；npm run dev 会用 --host 0.0.0.0 覆盖它，线上由 systemd/nginx 决定
HOST=127.0.0.1
PORT=4321
# development / production
NODE_ENV=development
# 访问统计按这个时区切「今天」
SITE_TIMEZONE=Asia/Shanghai

# ── 后台登录 ─────────────────────────────────────────────────────────────────
# /admin 的登录密码，建议 16 位以上随机串
ADMIN_PASSWORD=
# 登录签名 + 访客去重盐，至少 32 位。生成：openssl rand -hex 32
SESSION_SECRET=
# 登录 Cookie 名；同一域名下部署多个站点时改成不同的
ADMIN_COOKIE_NAME=bakamiku_admin

# ── 站点 ─────────────────────────────────────────────────────────────────────
# 对外地址，不要结尾斜杠，例如 https://blog.example.com
# 留空则按反向代理的 Host / X-Forwarded-Proto 推断
PUBLIC_SITE_URL=
# 备案号；留空时页脚显示占位文案
ICP_NUMBER=
MOE_ICP_NUMBER=

# ── 社交（留空则首页不显示对应按钮）────────────────────────────────────────
PUBLIC_GITHUB_URL=
PUBLIC_BILIBILI_URL=
PUBLIC_CONTACT_EMAIL=

# ── 网易云音乐接口 ───────────────────────────────────────────────────────────
# dev 下 /meting 的代理目标（线上由 nginx 反代，不走这里）
METING_TARGET=http://43.142.58.152
# netease / tencent / kugou / baidu
METING_SERVER=netease

# ── 功能开关（true/false，也认 1/0、yes/no、on/off）─────────────────────────
# 背景音乐播放器
FEATURE_BGM=true
# 页脚访问统计；关掉后不写 data/visits.json，也不显示统计条
FEATURE_VISITS=true
# 顶栏抽签挂件
FEATURE_FORTUNE=true
# 顶栏搜索框
FEATURE_SEARCH=true

# ── 其它 ─────────────────────────────────────────────────────────────────────
# 首页每页文章数（1-60）
PAGE_SIZE=12
